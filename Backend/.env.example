# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
#
#   cp .env.example .env

# ==== Bắt buộc ====

NODE_ENV=production

# Mongo đã cài sẵn trên VPS. Nếu có bật auth cho Mongo thì thêm user:pass vào URL:
#   mongodb://user:password@127.0.0.1:27017/ten_database
MONGO_URL=mongodb://127.0.0.1:27017/ludaitruong

# Secret ký/mã hoá access token JWT. Đổi ngay trước khi deploy thật, KHÔNG
# dùng giá trị mẫu. Tạo nhanh bằng: openssl rand -hex 32
JWT_ENCRYPT_KEY=

# Domain FrontEnd công khai - BẮT BUỘC vì FrontEnd (ludaitruongpmtl.com) và
# Backend (api.ludaitruongpmtl.com) là hai domain khác nhau, trình duyệt gọi
# thẳng API nên cần CORS. Nhiều domain thì phân tách bằng dấu phẩy.
FRONTEND_URL=https://ludaitruongpmtl.com,https://www.ludaitruongpmtl.com

# ==== Tuỳ chọn ====

# Cổng nội bộ Sails lắng nghe (Nginx proxy vào cổng này). Đổi nếu 1337 trùng
# với service khác trên VPS.
PORT=1337

# silly | verbose | info | debug | warn | error | silent
LOG_LEVEL=info

# Khi đổi JWT_ENCRYPT_KEY, thêm key cũ vào đây (phân tách bằng dấu phẩy) để
# token đã phát hành bằng key cũ vẫn còn dùng được một thời gian.
# JWT_ENCRYPT_FALLBACK_KEYS=

# Tài khoản Admin DUY NHẤT được sửa danh sách từ cấm mặc định.
TU_CAM_OWNER_EMAIL=

# --- Đăng nhập Google / Facebook (để trống = tắt, không chặn app chạy) ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Google reCAPTCHA v2 Checkbox (để trống = bỏ qua xác thực captcha) ---
# Site key cặp với secret key này khai báo ở FrontEnd (NEXT_PUBLIC_RECAPTCHA_SITE_KEY).
RECAPTCHA_SECRET_KEY=
# 'true' = vẫn cho đăng nhập khi không gọi được Google (mất mạng). Mặc định chặn.
RECAPTCHA_FAIL_OPEN=false
