# Copy file này thành `.env.production` (hoặc `.env`) rồi điền giá trị thật.
# KHÔNG commit .env* (trừ .env.example).
#
#   cp .env.example .env.production

# ==== Bắt buộc để chạy dữ liệu thật (không phải mock) ====

CONTENT_SOURCE=api

# URL công khai của Backend (Sails) - domain api riêng, KHÔNG phải
# http://localhost:1337 (xem ../deploy/nginx.conf.example).
NEXT_PUBLIC_API_URL=https://api.ludaitruongpmtl.com

# Domain công khai của site (dùng cho sitemap.xml, robots.txt, canonical URL, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://ludaitruongpmtl.com

# ==== Tuỳ chọn ====

# Secret cho webhook POST /api/revalidate (làm mới cache ngay khi admin đăng/sửa
# bài, không phải chờ hết hạn ISR). Tạo nhanh bằng: openssl rand -hex 32
REVALIDATE_SECRET=

# Đăng nhập Google / Facebook (để trống = ẩn nút đăng nhập tương ứng).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
